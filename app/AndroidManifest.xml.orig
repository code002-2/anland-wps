<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:compileSdkVersion="36" android:compileSdkVersionCodename="16" package="com.anland.appwrap" platformBuildVersionCode="36" platformBuildVersionName="16">
    <application android:allowBackup="false" android:extractNativeLibs="true" android:label="@string/app_name" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize" android:exported="true" android:name="com.anland.appwrap.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <receiver android:exported="true" android:name="com.anland.appwrap.CmdReceiver">
            <intent-filter>
                <action android:name="com.anland.appwrap.CMD"/>
            </intent-filter>
        </receiver>
        <activity android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize" android:documentLaunchMode="intoExisting" android:excludeFromRecents="false" android:exported="false" android:launchMode="standard" android:name="com.anlandnext.awl.AwlWindowActivity" android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <property android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY" android:value="true"/>
        </activity>
    </application>
</manifest>
